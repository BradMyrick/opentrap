# Build outputs (regenerated by build.sh)
/build/
/build-tests/
/dist/

# Bundled browser (large; fetched on demand by fetch-browser.sh)
/browser/

# Local app data, if ever created inside the tree
/.opentrap/

# Editor / OS noise
*.class
*.bak
*.orig
*.tmp
*.log
*~
.DS_Store
.idea/
.vscode/
*.iml

# ZAP scan engine (large; fetched on demand by fetch-zap.sh)
/engine/

# Local README preview (generated)
/readme-preview.html
