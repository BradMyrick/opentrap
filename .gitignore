# Build outputs (regenerated by build.sh)
/build/
/build-tests/
/dist/

# Bundled browser (large; fetched on demand by fetch-browser.sh)
/browser/

# Local app data, if ever created inside the tree
/.opentrap/

# Saved project files: full request/response history including session
# cookies and tokens. Never commit one.
*.otrap

# Editor / OS noise
*.class
*.bak
*.orig
*.tmp
*.log
*~
.DS_Store
.idea/
.vscode/
*.iml

# ZAP scan engine (large; fetched on demand by fetch-zap.sh)
/engine/

# AppImage build scratch
/AppDir/

# Portable JDK (large; fetched on demand by fetch-jdk.sh)
/jdk/
